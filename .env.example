# Client ID público do app headless (login OAuth, SDK do visitante e callback.html).
PUBLIC_WIX_CLIENT_ID=177d2fe1-7c67-4af7-a2e0-482dc527d3aa

# Chave de API com acesso ao site Headless (usada também pelo GitHub Actions).
WIX_API_TOKEN=your-server-api-key-or-app-token

# Site Wix Headless que hospeda o site: é ele que recebe o deploy.
WIX_SITE_ID=your-headless-site-id
WIX_SITE_URL=https://www.casaloba.com.br

# Exigidas pela integracao @wix/astro para gerar os metadados do release
# (.wix/build-metadata.json). O site usa auth client-side e o webhook da Ticto
# ainda nao chama APIs do Wix no servidor, entao valores provisorios bastam
# para buildar. Nunca versionar o segredo real.
WIX_CLIENT_ID=177d2fe1-7c67-4af7-a2e0-482dc527d3aa
WIX_CLIENT_INSTANCE_ID=build-placeholder
WIX_CLIENT_PUBLIC_KEY=build-placeholder
WIX_CLIENT_SECRET=build-placeholder
