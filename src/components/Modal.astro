---
// Estrutura reutilizável de diálogo modal, acessível pelo teclado e pelo botão de fechar.
interface Props {
  id: string;
  titulo: string;
}

const { id, titulo } = Astro.props;
const idTitulo = `${id}-titulo`;
---

<dialog id={id} class="modal" aria-labelledby={idTitulo}>
  <div class="modal__caixa">
    <button type="button" class="modal__fechar" aria-label="Fechar" data-fechar-modal>
      <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
        <path d="M5 5 L23 23 M23 5 L5 23" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
    <h2 id={idTitulo} class="modal__titulo">{titulo}</h2>
    <slot />
  </div>
</dialog>

<script src="../scripts/modais.js"></script>

<style>
  .modal {
    width: min(100% - 32px, 760px);
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 0;
    border: none;
    border-radius: var(--raio);
    background: var(--creme);
    color: var(--ameixa);
    overflow: hidden;
  }

  .modal::backdrop {
    background: rgba(43, 28, 46, 0.6);
  }

  /* A página atrás não rola enquanto um modal está aberto */
  :global(body:has(.modal[open])) {
    overflow: hidden;
  }

  /* O <dialog> não tem padding: assim, clique fora da caixa é clique no fundo */
  /* Quando o conteúdo é mais alto que a tela, quem rola é a caixa, para a barra
     de rolagem ficar dentro dos cantos arredondados */
  .modal__caixa {
    position: relative;
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    scrollbar-color: rgba(43, 28, 46, 0.4) transparent;
    padding: 56px 120px 48px;
  }

  .modal__fechar {
    position: absolute;
    top: 24px;
    right: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--ameixa);
    background: none;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .modal__fechar:hover {
    opacity: 0.6;
  }

  .modal__titulo {
    font-size: clamp(2rem, 4vw, 3rem);
    text-align: center;
  }

  /* Partes comuns aos formulários dos modais. O conteúdo chega pelo slot,
     por isso as classes ficam em :global() dentro da caixa do modal. */
  .modal__caixa :global(.modal__chamada) {
    margin-top: 12px;
    font-size: 1.25rem;
    text-align: center;
  }

  .modal__caixa :global(.modal__form) {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 32px;
  }

  .modal__caixa :global(.robo) {
    margin-top: 12px;
  }

  .modal__caixa :global(.modal__enviar) {
    align-self: center;
    min-width: 240px;
    margin-top: 16px;
  }

  @media (max-width: 860px) {
    .modal__caixa {
      padding: 56px 64px 40px;
    }
  }

  @media (max-width: 560px) {
    .modal__caixa {
      padding: 56px 24px 32px;
    }

    .modal__fechar {
      top: 12px;
      right: 12px;
    }

    .modal__caixa :global(.modal__chamada) {
      font-size: 1.1rem;
    }

    .modal__caixa :global(.modal__enviar) {
      align-self: stretch;
      min-width: 0;
    }
  }
</style>
