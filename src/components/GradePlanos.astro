---
// Grade de planos: usada na página inicial e em /planos, para ficarem idênticas.
import CartaoPlano from "./CartaoPlano.astro";
import { obterPlanos } from "../lib/planos";

const planos = await obterPlanos();

// Card livre: puramente visual (fora do CMS, sem nível de acesso e sem botão)
const planoLivre = {
  nome: "Loba Livre",
  selo: "porta de entrada",
  cor: "ameixa",
  preco: "R$ 0",
  beneficios: ["Acesso ao conteúdo aberto e à Newsletter", "Convites para os eventos"],
};
---

<div class="grid-planos">
  <CartaoPlano plano={planoLivre} />
  {planos.map((plano) => <CartaoPlano plano={plano} href="/pre-inscricao.html" />)}
</div>

<style>
  /* 4 colunas no desktop, 2 no tablet, 1 no celular */
  .grid-planos {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
  }

  @media (max-width: 1100px) {
    .grid-planos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .grid-planos {
      grid-template-columns: 1fr;
    }
  }
</style>