---
import CartaoPlano from "./CartaoPlano.astro";
import { PLANO_LIVRE, obterPlano, obterPlanos } from "../lib/planos";

const planoLivre = obterPlano(PLANO_LIVRE);
const planosPagos = await obterPlanos();
---

<div class="grid-planos">
  {planoLivre && <CartaoPlano plano={planoLivre} />}
  {planosPagos.map((plano) => <CartaoPlano plano={plano} href="/pre-inscricao.html" />)}
</div>

<style>
  .grid-planos {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
  }

  @media (max-width: 1100px) {
    .grid-planos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .grid-planos {
      grid-template-columns: 1fr;
    }
  }
</style>
