---
import Logo from "./Logo.astro";

// Rodapé único do site: mesma navegação, mesma tagline e mesmo copyright em
// todas as páginas (landing, planos, pré-inscrição e documentos legais).
---

<footer class="footer">
  <div class="container footer__inner">
    <div>
      <Logo href="/" tamanho="1.2em" cor="var(--creme)" class="footer__logo" />
      <p class="footer__texto">Quem cuida também precisa de uma rede.</p>
    </div>

    <nav class="footer__links" aria-label="Navegação do rodapé">
      <a href="/#secao-sobre">Sobre a Casa Loba</a>
      <a href="/#secao-frentes">Nossas frentes</a>
      <a href="/#secao-planos">Planos</a>
      <a href="/#secao-publico">Para quem é</a>
      <a href="/termos-de-uso.html">Termos de uso</a>
      <a href="/politica-de-privacidade.html">Política de privacidade</a>
    </nav>

    <p class="footer__copy">© {new Date().getFullYear()} Casa Loba · feito com cuidado</p>
  </div>
</footer>

<style>
  /* O logo vem do componente Logo (mesma fonte do cabeçalho), em creme para
     contrastar com o fundo ameixa. */
</style>
