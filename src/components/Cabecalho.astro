---
import Logo from "./Logo.astro";

interface Props {
  solido?: boolean;
}

const { solido = false } = Astro.props;
---

<nav
  class:list={["nav-flutuante", { "is-scrolled": solido }]}
  id="navFlutuante"
>
  <div class="container nav-flutuante__inner">
    <Logo href="/#topo" />
    <div class="nav-links">
      <a href="/#secao-sobre">Sobre a Casa Loba</a>
      <a href="/#secao-frentes">Nossas frentes</a>
      <a href="/#secao-planos" class="nav-planos">Planos</a>
      <div class="nav-auth" data-nav-auth>
        <button class="btn btn--sm btn--vermelho" type="button" data-entrar-wix>Entrar</button>
        <button class="nav-auth__cadastro" type="button" data-cadastrar-wix>Cadastrar</button>
      </div>
    </div>
  </div>
</nav>

<script>
  import { sairDaConta, usuariaDaPagina } from "../lib/sessao";
  import { ligarBotaoEntrar } from "../lib/auth/iniciarLoginWix";
  import { destinoSeguro } from "../lib/auth/contrato";
  import type { Usuaria } from "../lib/usuaria";

  const nav = document.getElementById("navFlutuante");
  if (nav && !nav.classList.contains("is-scrolled")) {
    window.addEventListener("scroll", () => {
      nav.classList.toggle("is-scrolled", window.scrollY > 40);
    });
  }

  const destino = destinoSeguro(new URLSearchParams(window.location.search).get("redirect"));
  const area = document.querySelector<HTMLElement>("[data-nav-auth]");

  function montarMenuConta(usuaria: Usuaria): HTMLElement {
    const menu = document.createElement("details");
    menu.className = "perfil-menu";
    const resumo = document.createElement("summary");
    resumo.className = "perfil-link";
    resumo.setAttribute("aria-label", `Menu da conta de ${usuaria.nome}`);
    const avatar = document.createElement("span");
    avatar.className = "perfil-link__avatar";
    avatar.setAttribute("aria-hidden", "true");
    if (usuaria.imagem) {
      const imagem = document.createElement("img");
      imagem.src = usuaria.imagem;
      imagem.alt = "";
      avatar.append(imagem);
    } else {
      avatar.textContent = usuaria.nome.charAt(0).toUpperCase();
    }
    const nome = document.createElement("span");
    nome.className = "perfil-link__nome";
    nome.textContent = usuaria.nome;
    resumo.append(avatar, nome);

    const opcoes = document.createElement("div");
    opcoes.className = "perfil-menu__opcoes";
    const areaMembros = document.createElement("a");
    areaMembros.href = "/membros.html";
    areaMembros.textContent = "Área de membros";
    const perfil = document.createElement("a");
    perfil.href = "/membros/perfil.html";
    perfil.textContent = "Perfil";
    const sair = document.createElement("button");
    sair.type = "button";
    sair.className = "perfil-menu__sair";
    sair.textContent = "Sair";
    sair.addEventListener("click", async () => {
      try {
        await sairDaConta();
      } catch (erro) {
        const aviso = document.createElement("span");
        aviso.setAttribute("role", "alert");
        aviso.textContent = erro instanceof Error ? erro.message : "Não foi possível sair da conta.";
        area?.append(aviso);
      }
    });
    opcoes.append(areaMembros, perfil, sair);
    menu.append(resumo, opcoes);
    return menu;
  }

  if (area) {
    const entrar = area.querySelector<HTMLButtonElement>("[data-entrar-wix]");
    if (entrar) ligarBotaoEntrar(entrar, { modo: "login", destino });
    const cadastrar = area.querySelector<HTMLButtonElement>("[data-cadastrar-wix]");
    if (cadastrar) ligarBotaoEntrar(cadastrar, { modo: "signup", destino });

    try {
      const usuaria = await usuariaDaPagina();
      if (usuaria) area.replaceChildren(montarMenuConta(usuaria));
    } catch (erro) {
      console.error("Não foi possível carregar a sessão no cabeçalho.", erro);
    }
  }

  document.addEventListener("click", (evento) => {
    const menu = document.querySelector<HTMLDetailsElement>(".perfil-menu");
    if (!menu?.open) return;
    if (evento.target instanceof Node && !menu.contains(evento.target)) {
      menu.open = false;
    }
  });
</script>

<style>
  .nav-flutuante {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: 20px 0;
    transition: background 0.3s ease, padding 0.3s ease, box-shadow 0.3s ease;
  }

  .nav-flutuante__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    font-family: var(--font-titulo);
    font-weight: 600;
  }

  .nav-auth {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  :global(.nav-auth__cadastro),
  .nav-links a,
  .nav-links button {
    font-size: 0.95rem;
    transition: opacity 0.2s;
  }

  :global(button.nav-auth__cadastro) {
    color: inherit;
    background: none;
    border: none;
    font-family: var(--font-titulo);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
  }

  .nav-links button {
    line-height: inherit;
  }

  .nav-links a:hover,
  .nav-links button:hover {
    opacity: 0.6;
  }

  .nav-flutuante.is-scrolled {
    background: var(--creme);
    padding: 12px 0;
    box-shadow: 0 1px 0 rgba(43, 28, 46, 0.08);
  }

  :global(.perfil-link) {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 4px 16px 4px 4px;
    border: 1.5px solid var(--ameixa);
    border-radius: var(--capsula);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  :global(.perfil-link::-webkit-details-marker) {
    display: none;
  }

  :global(.perfil-menu) {
    position: relative;
  }

  :global(.perfil-menu__opcoes) {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    display: grid;
    min-width: 150px;
    gap: 4px;
    padding: 8px;
    border: 1px solid rgba(43, 28, 46, 0.15);
    border-radius: 16px;
    background: var(--creme);
    box-shadow: 0 8px 24px rgba(43, 28, 46, 0.16);
  }

  :global(.perfil-menu__opcoes a),
  :global(.perfil-menu__sair) {
    padding: 8px 12px;
    border-radius: 10px;
    font: inherit;
    text-align: left;
  }

  :global(.perfil-menu__sair) {
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }

  :global(.perfil-link__avatar) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--capsula);
    overflow: hidden;
    background: var(--vermelho);
    color: var(--creme);
    font-weight: 800;
    line-height: 1;
  }

  :global(.perfil-link__avatar img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 860px) {
    .nav-links {
      gap: 16px;
      font-size: 0.85rem;
    }
  }

  @media (max-width: 700px) {
    .nav-links a:not(.btn, .perfil-link, .nav-planos) {
      display: none;
    }

    :global(.perfil-link) {
      padding: 4px;
    }

    :global(.perfil-link__nome) {
      display: none;
    }

    .nav-auth {
      gap: 8px;
    }

    :global(.nav-auth__cadastro) {
      display: none;
    }
  }
</style>
