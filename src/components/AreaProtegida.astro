---
import "../styles/membros.css";
---

<div class="area-protegida__carregando" role="status" data-guard-loading>
  Conferindo seu acesso…
</div>
<div data-guard-content hidden>
  <slot />
</div>

<script>
  import { exigirLogin } from "../lib/guarda";
  import { auth } from "../lib/auth";

  const carregando = document.querySelector<HTMLElement>("[data-guard-loading]");
  const conteudo = document.querySelector<HTMLElement>("[data-guard-content]");

  async function montarSeletorDev(emailAtual: string): Promise<void> {
    const contas = await auth.contasDemo();
    if (contas.length === 0) return;

    const seletor = document.createElement("label");
    seletor.className = "seletor-plano-dev";
    seletor.textContent = "Trocar plano (DEV)";
    const select = document.createElement("select");
    select.setAttribute("aria-label", "Trocar usuária de demonstração");
    for (const conta of contas) {
      const opcao = document.createElement("option");
      opcao.value = conta.email;
      opcao.textContent = conta.nome;
      opcao.selected = emailAtual === conta.email;
      select.append(opcao);
    }
    select.addEventListener("change", async () => {
      await auth.entrarDemo(select.value);
      window.location.reload();
    });
    seletor.append(select);
    document.body.append(seletor);
  }

  const usuaria = await exigirLogin();
  if (usuaria && carregando && conteudo) {
    carregando.hidden = true;
    conteudo.hidden = false;
    if (import.meta.env.DEV) await montarSeletorDev(usuaria.email);
  }
</script>

<style>
  .area-protegida__carregando {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 32px;
    font-weight: 700;
  }
</style>
