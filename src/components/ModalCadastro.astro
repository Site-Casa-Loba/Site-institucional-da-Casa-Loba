---
// Modal de cadastro. Cadastro é só modal: não existe a rota /cadastro.
// Aberto pelo "Cadastre-se" do modal de login.
import Modal from "./Modal.astro";

const meses = [
  "Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho",
  "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro",
];
---

<Modal id="modalCadastro" titulo="cadastro">
  <p class="modal__chamada">
    Já tem uma conta? <button type="button" class="link" data-abrir-modal="modalLogin">Fazer login</button>
  </p>

  <!-- PLACEHOLDER: o formulário não envia nada, só impede o recarregamento da página,
       e não confere se as senhas são iguais. Para virar funcional, precisa do cadastro
       de membros do Wix Headless e da validação dos campos. -->
  <form class="modal__form" data-form-placeholder>
    <label class="campo">
      <span>Nome</span>
      <input class="campo__entrada" type="text" name="nome" autocomplete="given-name" />
    </label>

    <label class="campo">
      <span>Sobrenome</span>
      <input class="campo__entrada" type="text" name="sobrenome" autocomplete="family-name" />
    </label>

    <fieldset class="aniversario">
      <legend class="aniversario__legenda">Aniversário</legend>
      <div class="aniversario__campos">
        <label class="campo">
          <span>Dia</span>
          <input class="campo__entrada" type="text" inputmode="numeric" maxlength="2" name="dia" autocomplete="bday-day" />
        </label>

        <label class="campo">
          <span>Mês</span>
          <select class="campo__entrada" name="mes" autocomplete="bday-month">
            <option value="" selected disabled hidden></option>
            {meses.map((mes, i) => <option value={i + 1}>{mes}</option>)}
          </select>
        </label>

        <label class="campo">
          <span>Ano</span>
          <input class="campo__entrada" type="text" inputmode="numeric" maxlength="4" name="ano" autocomplete="bday-year" />
        </label>
      </div>
    </fieldset>

    <label class="campo">
      <span>Telefone</span>
      <input class="campo__entrada" type="tel" name="telefone" autocomplete="tel" />
    </label>

    <label class="campo">
      <span>Email</span>
      <input class="campo__entrada" type="email" name="email" autocomplete="email" />
    </label>

    <label class="campo">
      <span>Senha</span>
      <input class="campo__entrada" type="password" name="senha" autocomplete="new-password" />
    </label>

    <label class="campo">
      <span>Confirme sua senha</span>
      <input class="campo__entrada" type="password" name="confirmacao-senha" autocomplete="new-password" />
    </label>

    <!-- PLACEHOLDER: "Não sou um robô" apenas visual, ver .robo em src/styles/formulario.css. -->
    <label class="robo">
      <input type="checkbox" name="robo" />
      <span>Não sou um robô</span>
    </label>

    <button type="submit" class="btn btn--vermelho modal__enviar">cadastrar-se</button>
  </form>
</Modal>

<style>
  .aniversario {
    min-width: 0;
    border: none;
  }

  .aniversario__legenda {
    margin-bottom: 6px;
  }

  /* Dia, Mês e Ano lado a lado, com o Mês um pouco mais largo, como no PDF */
  .aniversario__campos {
    display: grid;
    grid-template-columns: 3fr 4fr 3fr;
    gap: 24px;
  }

  @media (max-width: 560px) {
    .aniversario__campos {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
