---
// Card de um plano, montado com as classes .plano* de src/styles/global.css.
// Os dados vêm do catálogo em src/lib/planos.ts (ou do card livre, em GradePlanos.astro).
import type { Plano } from "../lib/planos";

interface Props {
  // O card livre não tem id nem uma cor do catálogo, por isso esses dois campos são soltos
  plano: Omit<Plano, "id" | "cor"> & { cor: string };
  // Destino do botão "assinar plano". Sem href, o card aparece sem botão.
  href?: string;
}

const { plano, href } = Astro.props;
---

<article class:list={["plano", { "plano--destaque": plano.destaque }]}>
  <span class={`plano__selo plano__selo--${plano.cor}`}>{plano.selo}</span>
  <h3 class="plano__nome">{plano.nome}</h3>
  <p class="plano__preco"><span>{plano.preco}</span>/mês</p>
  <ul class="plano__lista">
    {plano.beneficios.map((beneficio: string) => <li>{beneficio}</li>)}
  </ul>
  {href && (
    <a href={href} class={`btn btn--${plano.cor} btn--full`}><span>assinar plano</span> <span>{plano.nome}</span></a>
  )}
</article>

<style>
  /* O card tem fundo próprio: mantém o texto ameixa mesmo em seção escura */
  .plano {
    color: var(--ameixa);
  }

  /* H3 de card no guia visual: Outfit 700 */
  .plano__nome {
    font-weight: 700;
  }

  /* Botões alinhados na base e com a mesma altura em todos os cards */
  .btn {
    margin-top: auto;
    flex-direction: column;
    text-align: center;
    line-height: 1.25;
    padding: 12px 16px;
  }
</style>