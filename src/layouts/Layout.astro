---
// Layout base do site institucional da Casa Loba.
// Shell HTML preservando exatamente o <head> original do index.html estático.
import "../styles/global.css";
import "../styles/formulario.css";
import "../styles/membros.css";

interface Props {
  titulo?: string;
}

const { titulo = "Casa Loba" } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Casa Loba | {titulo}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Nunito:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
