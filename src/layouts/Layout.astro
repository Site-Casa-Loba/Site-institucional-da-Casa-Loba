---
// Layout base do site institucional da Casa Loba.
// Metadados e estrutura compartilhada das páginas.
interface Props {
  title?: string;
  noindex?: boolean;
}

const { title = "Casa Loba — Rede de apoio para mulheres e mães", noindex = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="description" content="Conheça a Casa Loba, uma comunidade para mulheres e mães que aproxima cuidado, empreendedorismo e conexões para desenvolver seus projetos." />
    <meta property="og:title" content="Casa Loba — Quem cuida também precisa de uma rede" />
    <meta property="og:description" content="Uma rede para mulheres e mães compartilharem experiências, criarem conexões e desenvolverem seus projetos. Conheça a Casa Loba." />
    <meta property="og:site_name" content="Casa Loba" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Casa Loba — Quem cuida também precisa de uma rede" />
    <meta name="twitter:description" content="Uma rede para mulheres e mães compartilharem experiências, criarem conexões e desenvolverem seus projetos. Conheça a Casa Loba." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Nunito:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <slot />
  </body>
</html>
