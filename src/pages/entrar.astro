---
import Layout from "../layouts/Layout.astro";
import Cabecalho from "../components/Cabecalho.astro";
---

<Layout title="Entrar — Casa Loba" noindex>
  <Cabecalho solido />
  <main class="tela-acesso">
    <section class="painel-acesso painel-entrar" aria-labelledby="titulo-entrar">
      <p class="tag tag--ameixa">sua casa, seu tempo</p>
      <h1 id="titulo-entrar">Entrar na Casa</h1>
      <p class="painel-entrar__chamada">
        Ainda não tem uma conta? <button class="painel-entrar__link" type="button" id="botao-cadastrar-wix">Cadastre-se</button>
      </p>
      <button class="btn btn--vermelho btn--full" type="button" id="botao-entrar-wix">Entrar</button>
      <p class="form-acesso__mensagem painel-entrar__mensagem" id="mensagem-entrar" aria-live="assertive" tabindex="-1"></p>
    </section>
  </main>
</Layout>

<script>
  import { usuariaDaPagina } from "../lib/sessao";
  import { ligarBotaoEntrar } from "../lib/auth/iniciarLoginWix";
  import { destinoSeguro } from "../lib/auth/contrato";

  const mensagem = document.querySelector<HTMLElement>("#mensagem-entrar");
  const destino = destinoSeguro(new URLSearchParams(window.location.search).get("redirect"));

  const botaoEntrar = document.querySelector<HTMLButtonElement>("#botao-entrar-wix");
  if (botaoEntrar) ligarBotaoEntrar(botaoEntrar, { modo: "login", destino, mensagem });

  const botaoCadastrar = document.querySelector<HTMLButtonElement>("#botao-cadastrar-wix");
  if (botaoCadastrar) ligarBotaoEntrar(botaoCadastrar, { modo: "signup", destino, mensagem });

  if (import.meta.env.DEV) {
    const { CONTAS_DEMO } = await import("../lib/auth/demo");
    const { auth } = await import("../lib/auth");

    const caixa = document.createElement("div");
    caixa.className = "painel-entrar__demo";
    const rotulo = document.createElement("label");
    rotulo.textContent = "Conta de demonstração (DEV)";
    const select = document.createElement("select");
    select.setAttribute("aria-label", "Entrar com conta de demonstração");
    for (const conta of CONTAS_DEMO) {
      const opcao = document.createElement("option");
      opcao.value = conta.email;
      opcao.textContent = `${conta.nome} (${conta.email})`;
      select.append(opcao);
    }
    const botaoDemo = document.createElement("button");
    botaoDemo.type = "button";
    botaoDemo.className = "btn btn--vermelho btn--full";
    botaoDemo.textContent = "Entrar com a conta de demonstração";
    botaoDemo.addEventListener("click", async () => {
      try {
        await auth.entrarDemo(select.value);
        window.location.replace(destino);
      } catch (erro) {
        if (mensagem) {
          mensagem.textContent = erro instanceof Error ? erro.message : "Não foi possível entrar com a conta de demonstração.";
          mensagem.focus();
        }
      }
    });
    rotulo.append(select);
    caixa.append(rotulo, botaoDemo);
    document.querySelector(".painel-entrar")?.append(caixa);
  }

  try {
    if (await usuariaDaPagina()) window.location.replace("/membros.html");
  } catch (erro) {
    if (mensagem) {
      mensagem.textContent = erro instanceof Error ? erro.message : "Não foi possível verificar sua sessão.";
      mensagem.focus();
    }
  }
</script>

<style>
  .painel-entrar {
    width: min(100% - 32px, 520px);
    text-align: center;
  }

  .painel-entrar h1 {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .painel-entrar__chamada {
    margin-top: 12px;
    font-size: 1.25rem;
  }

  .painel-entrar__chamada a,
  .painel-entrar__link {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .painel-entrar__link {
    color: inherit;
    background: none;
    border: none;
    font: inherit;
    cursor: pointer;
    padding: 0;
  }

  .painel-entrar > .btn--full {
    margin-top: 28px;
  }

  .painel-entrar__mensagem {
    margin-top: 12px;
  }

  .painel-entrar__demo {
    display: grid;
    gap: 12px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px dashed var(--ameixa);
    font-size: 0.95rem;
  }

  .painel-entrar__demo label {
    display: grid;
    gap: 6px;
    opacity: 0.85;
  }

  .painel-entrar__demo select {
    padding: 8px 10px;
    border: 1px solid var(--ameixa);
    border-radius: 8px;
    background: #fff;
    color: var(--ameixa);
    font: inherit;
  }

  @media (max-width: 560px) {
    .painel-entrar__chamada {
      font-size: 1.1rem;
    }
  }
</style>
