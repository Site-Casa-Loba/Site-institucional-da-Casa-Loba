---
import Layout from "../layouts/Layout.astro";
import Cabecalho from "../components/Cabecalho.astro";
---

<Layout title="Entrar — Casa Loba">
  <Cabecalho solido />
  <main class="tela-acesso">
    <section class="painel-acesso painel-entrar" aria-labelledby="titulo-entrar">
      <p class="tag tag--ameixa">sua casa, seu tempo</p>
      <h1 id="titulo-entrar">Entrar na Casa</h1>
      <p class="painel-entrar__chamada">
        Ainda não tem uma conta? <button class="painel-entrar__link" type="button" id="botao-cadastrar-wix">Cadastre-se</button>
      </p>
      <button class="btn btn--vermelho btn--full" type="button" id="botao-entrar-wix">Entrar</button>
      <p class="form-acesso__mensagem painel-entrar__mensagem" id="mensagem-entrar" aria-live="assertive" tabindex="-1"></p>
      <a class="painel-entrar__esqueci" href="/recuperar-senha.html">Esqueci minha senha</a>
    </section>
  </main>
</Layout>

<script>
  import { auth } from "../lib/auth";
  import { iniciarLoginWix } from "../lib/auth/iniciarLoginWix";

  const mensagem = document.querySelector<HTMLElement>("#mensagem-entrar");
  const botaoWix = document.querySelector<HTMLButtonElement>("#botao-entrar-wix");
  const params = new URLSearchParams(window.location.search);
  const redirect = params.get("redirect");
  const destino = redirect?.startsWith("/") && !redirect.startsWith("//") ? redirect : "/membros.html";

  botaoWix?.addEventListener("click", () => {
    botaoWix.disabled = true;
    botaoWix.textContent = "Entrando…";
    iniciarLoginWix(destino).catch((erro) => {
      console.error("[auth] não foi possível iniciar o login:", erro);
      botaoWix.disabled = false;
      botaoWix.textContent = "Entrar";
      if (mensagem) {
        mensagem.textContent = "Não foi possível entrar. Tente novamente.";
        mensagem.focus();
      }
    });
  });

  const botaoCadastrar = document.querySelector<HTMLButtonElement>("#botao-cadastrar-wix");
  botaoCadastrar?.addEventListener("click", () => {
    botaoCadastrar.disabled = true;
    botaoCadastrar.textContent = "Abrindo cadastro…";
    iniciarLoginWix(destino, "signup").catch((erro) => {
      console.error("[auth] não foi possível iniciar o cadastro:", erro);
      botaoCadastrar.disabled = false;
      botaoCadastrar.textContent = "Cadastre-se";
      if (mensagem) {
        mensagem.textContent = "Não foi possível abrir o cadastro. Tente novamente.";
        mensagem.focus();
      }
    });
  });

  try {
    if (await auth.usuariaAtual()) window.location.replace("/membros.html");
  } catch (erro) {
    if (mensagem) {
      mensagem.textContent = erro instanceof Error ? erro.message : "Não foi possível verificar sua sessão.";
      mensagem.focus();
    }
  }

</script>

<style>
  /* Tela de login no visual da identidade (commit 7727f12):
     painel estreito e centralizado, título e chamada centralizados. */
  .painel-entrar {
    width: min(100% - 32px, 520px);
    text-align: center;
  }

  .painel-entrar h1 {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .painel-entrar__chamada {
    margin-top: 12px;
    font-size: 1.25rem;
  }

  .painel-entrar__chamada a,
  .painel-entrar__link {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .painel-entrar__link {
    color: inherit;
    background: none;
    border: none;
    font: inherit;
    cursor: pointer;
    padding: 0;
  }

  .painel-entrar > .btn--full {
    margin-top: 28px;
  }

  .painel-entrar__mensagem {
    margin-top: 12px;
  }

  .painel-entrar__esqueci {
    display: inline-block;
    margin-top: 8px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 560px) {
    .painel-entrar__chamada {
      font-size: 1.1rem;
    }
  }
</style>
