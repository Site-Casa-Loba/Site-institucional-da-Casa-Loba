---
// Página de exemplo da integração com o CMS (ver docs/CMS.md).
// Lista o catálogo de planos lido do Wix Data — artefato de validação
// da tarefa "Validar leitura do CMS pelo Astro". Não exibe conteúdo
// da área de membros. Remover quando a integração for definitiva.
import Layout from "../layouts/Layout.astro";
import Cabecalho from "../components/Cabecalho.astro";
import { obterPlanosCms } from "../lib/cms";

const planos = await obterPlanosCms();
const beneficios = (texto: string) =>
  (texto ?? "")
    .split("\n")
    .map((linha) => linha.trim())
    .filter(Boolean);
---

<Layout title="Teste do CMS — Casa Loba" noindex>
  <Cabecalho solido />
  <main class="tela-acesso">
    <section class="painel-acesso" style="max-width: 720px;">
      <p class="tag tag--ameixa">cms · wix data</p>
      <h1>Leitura do CMS pelo Astro</h1>
      <p class="painel-acesso__intro">
        Dados lidos da coleção <code>planos</code> do site via SDK do Wix,
        no build. Ver <code>docs/CMS.md</code>.
      </p>

      {planos.ok ? (
        <ul>
          {planos.dados.map((plano) => (
            <li>
              <strong>{plano.nome}</strong> — {plano.selo} — {plano.preco_texto}/mês
              {plano.destaque && " · destaque"}
              <ul>
                {beneficios(plano.beneficios).map((beneficio) => (
                  <li>{beneficio}</li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      ) : (
        <p role="alert">Não foi possível ler a coleção <code>planos</code>: {planos.erro}</p>
      )}
    </section>
  </main>
</Layout>
