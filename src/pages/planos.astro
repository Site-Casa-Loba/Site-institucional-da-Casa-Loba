---
import Layout from "../layouts/Layout.astro";
import Cabecalho from "../components/Cabecalho.astro";
import GradePlanos from "../components/GradePlanos.astro";
import Rodape from "../components/Rodape.astro";
---

<Layout 
  title="Planos — Casa Loba" 
  description="Conheça os planos da Casa Loba e escolha a forma de participação que combina com o seu momento na comunidade.">
  <Cabecalho solido />

  <main class="pagina-bordo">
    <div class="container container--largo">
      <header class="section-head">
        <h1 class="section-titulo">Encontre seu lugar na Casa Loba</h1>
        <p class="section-sub">Conheça as opções de participação e escolha a que combina com o seu momento.</p>
      </header>

      <GradePlanos />
    </div>
  </main>

  <Rodape />
</Layout>

<style>
  .section-head {
    max-width: 760px;
  }
</style>