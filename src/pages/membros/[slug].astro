---
import Layout from "../../layouts/Layout.astro";
import Cabecalho from "../../components/Cabecalho.astro";
import AreaProtegida from "../../components/AreaProtegida.astro";
import { SLUGS_CONTEUDOS } from "../../lib/membrosCms";

// Site 100% estático: prerenderiza todos os slugs (o título real e o
// conteúdo vêm do CMS no navegador, após o login).
export const prerender = true;

export function getStaticPaths() {
  return SLUGS_CONTEUDOS.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
---

<Layout title="Membro — Casa Loba" noindex>
  <Cabecalho solido />
  <AreaProtegida>
    <main class="pagina-conteudo-membro" data-pagina-conteudo data-slug={slug}>
      <div class="container">
        <a class="membros-voltar" href="/membros.html">← Voltar à área de membros</a>
        <div data-conteudo-dinamico aria-live="polite"></div>
      </div>
    </main>
  </AreaProtegida>
</Layout>

<script>
  import { usuariaDaPagina } from "../../lib/sessao";
  import { obterPlano, temAcessoAoConteudo } from "../../lib/planos";
  import { obterConteudoMembro, type ConteudoMembro } from "../../lib/membrosCms";
  import type { Usuaria } from "../../lib/usuaria";

  const pagina = document.querySelector<HTMLElement>("[data-pagina-conteudo]");
  const destino = document.querySelector<HTMLElement>("[data-conteudo-dinamico]");
  const slug = pagina?.dataset.slug ?? "";

  const criar = (tag: string, classe?: string, texto?: string): HTMLElement => {
    const elemento = document.createElement(tag);
    if (classe) elemento.className = classe;
    if (texto) elemento.textContent = texto;
    return elemento;
  };

  function montarArtigo(conteudo: ConteudoMembro): HTMLElement {
    const artigo = criar("article", "conteudo-artigo");
    const corpo = criar("div", "conteudo-artigo__corpo");
    if (conteudo.video_url) {
      const videoWrapper = criar("div", "video-wrapper");
      const iframe = document.createElement("iframe");
      iframe.src = conteudo.video_url;
      iframe.title = `Vídeo: ${conteudo.titulo}`;
      iframe.loading = "lazy";
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
      iframe.allowFullscreen = true;
      videoWrapper.append(iframe);
      corpo.append(videoWrapper);
    }
    corpo.append(
      criar("p", undefined, conteudo.conteudo),
      criar("p", undefined, "Este conteúdo é uma demonstração e poderá ser expandido com os materiais da Casa Loba."),
    );
    artigo.append(
      criar("p", "tag tag--ameixa", conteudo.categoria),
      criar("h1", undefined, conteudo.titulo),
      criar("p", "conteudo-artigo__resumo", conteudo.resumo),
      corpo,
    );
    return artigo;
  }

  function montarBloqueio(conteudo: ConteudoMembro, usuaria: Usuaria): HTMLElement {
    const planoNecessario = obterPlano(conteudo.plano);
    const nomeNecessario = planoNecessario?.nome ?? conteudo.plano;
    const nomeAtual = obterPlano(usuaria.plano)?.nome ?? "não identificado";

    const bloqueio = criar("section", "conteudo-bloqueado");
    bloqueio.setAttribute("aria-labelledby", "titulo-bloqueio");

    const titulo = criar("h1", undefined, conteudo.titulo);
    titulo.id = "titulo-bloqueio";

    const lista = criar("ul", "conteudo-bloqueado__beneficios");
    for (const beneficio of planoNecessario?.beneficios ?? []) {
      lista.append(criar("li", undefined, beneficio));
    }

    const acoes = criar("div", "perfil-acoes");
    const conhecer = criar("a", "btn btn--vermelho", `Conhecer o plano ${nomeNecessario}`);
    conhecer.setAttribute("href", "/planos.html");
    const voltar = criar("a", "btn btn--ghost", "Voltar aos conteúdos");
    voltar.setAttribute("href", "/membros.html");
    acoes.append(conhecer, voltar);

    bloqueio.append(
      criar("p", "tag tag--ameixa", "conteúdo exclusivo"),
      titulo,
      criar("p", "conteudo-artigo__resumo", conteudo.resumo),
      criar(
        "p",
        "conteudo-bloqueado__resumo",
        `Este conteúdo está disponível a partir do plano ${nomeNecessario}. Seu plano atual é ${nomeAtual}.`,
      ),
      lista,
      acoes,
    );
    return bloqueio;
  }

  const usuaria = await usuariaDaPagina();
  const conteudo = usuaria ? await obterConteudoMembro(slug).catch(() => null) : null;

  if (usuaria && destino) {
    if (!conteudo) {
      destino.innerHTML =
        '<p role="alert">Não foi possível carregar este conteúdo agora. ' +
        '<a href="/membros.html">Voltar à área de membros</a></p>';
    } else {
      destino.append(
        temAcessoAoConteudo(usuaria.plano, conteudo.plano)
          ? montarArtigo(conteudo)
          : montarBloqueio(conteudo, usuaria),
      );
    }
  }
</script>
