---
// Mural de networking (V2): espaço de trocas e pedidos entre as membras.
// Funciona no navegador (localStorage) até existir backend — ver aviso na própria página.
import Layout from "../../layouts/Layout.astro";
import Cabecalho from "../../components/Cabecalho.astro";
import AreaProtegida from "../../components/AreaProtegida.astro";
---

<Layout title="Mural de networking — Casa Loba" noindex>
  <Cabecalho solido />
  <AreaProtegida>
    <main class="pagina-membros-interna">
      <div class="container">
        <a class="membros-voltar" href="/membros.html">← Voltar à área de membros</a>
        <header class="membros-cabecalho">
          <p class="tag">networking</p>
          <h1>mural de conexões</h1>
          <p>Pedidos, ofertas e conquistas: o espaço da matilha para se ajudar.</p>
        </header>

        <section class="membros-secao" aria-labelledby="titulo-publicar">
          <h2 id="titulo-publicar">Nova publicação</h2>
          <form class="painel-membro mural-form" id="form-publicacao" novalidate>
            <label class="campo">
              <span>O que você quer contar pra matilha?</span>
              <textarea
                class="campo__entrada mural-form__texto"
                name="texto"
                rows="3"
                minlength="4"
                maxlength="280"
                required
                placeholder="Ex.: procuro uma fotógrafa para meu catálogo…"
              ></textarea>
            </label>
            <p class="form-acesso__mensagem" id="mensagem-publicacao" aria-live="polite" tabindex="-1"></p>
            <button class="btn btn--vermelho" type="submit">Publicar no mural</button>
          </form>
        </section>

        <section class="membros-secao" aria-labelledby="titulo-mural">
          <h2 id="titulo-mural">Publicações</h2>
          <div class="membros-grade" id="mural" aria-live="polite"></div>
          <p class="mural-vazio" id="mural-vazio" hidden>
            Ainda não há publicações. Seja a primeira a compartilhar com a matilha.
          </p>
          <p class="aviso-demo">
            <strong>Ambiente de demonstração:</strong> as publicações e curtidas ficam salvas só
            neste navegador. Quando o backend do mural existir, elas passam a ser da comunidade.
          </p>
        </section>
      </div>
    </main>
  </AreaProtegida>
</Layout>

<style>
  .mural-form {
    display: grid;
    gap: 18px;
  }

  .mural-form__texto {
    width: 100%;
    resize: vertical;
    border-radius: 16px;
    background: #fff;
  }

  .mural-vazio {
    padding: 24px;
    border-radius: 24px;
    background: #fff;
    opacity: 0.9;
  }
</style>

<script>
  import { auth } from "../../lib/auth";

  const CHAVE_POSTAGENS = "casa-loba-mural-postagens";
  const CHAVE_CURTIDAS = "casa-loba-mural-curtidas";

  const mural = document.querySelector<HTMLElement>("#mural");
  const vazio = document.querySelector<HTMLElement>("#mural-vazio");
  const form = document.querySelector<HTMLFormElement>("#form-publicacao");
  const mensagem = document.querySelector<HTMLElement>("#mensagem-publicacao");

  const usuaria = await auth.usuariaAtual();

  interface Postagem {
    id: string;
    autora: string;
    texto: string;
    quando: string;
    curtidas: number;
  }

  function lerJson<T>(chave: string, fallback: T): T {
    try {
      const bruto = window.localStorage.getItem(chave);
      return bruto ? (JSON.parse(bruto) as T) : fallback;
    } catch (erro) {
      console.error(`Não foi possível ler "${chave}" no navegador.`, erro);
      return fallback;
    }
  }

  function salvarJson(chave: string, dados: unknown): void {
    try {
      window.localStorage.setItem(chave, JSON.stringify(dados));
    } catch (erro) {
      console.error(`Não foi possível salvar "${chave}" no navegador.`, erro);
    }
  }

  function renderizar(): void {
    if (!mural) return;
    const postagens = lerJson<Postagem[]>(CHAVE_POSTAGENS, []);
    const curtidas = lerJson<string[]>(CHAVE_CURTIDAS, []);
    mural.replaceChildren();
    if (vazio) vazio.hidden = postagens.length > 0;

    for (const postagem of postagens) {
      const card = document.createElement("article");
      card.className = "card publicacao";

      const cabecalho = document.createElement("div");
      cabecalho.className = "publicacao__cabecalho";
      const avatar = document.createElement("span");
      avatar.className = "publicacao__avatar";
      avatar.setAttribute("aria-hidden", "true");
      avatar.textContent = postagem.autora.charAt(0).toUpperCase();
      const autora = document.createElement("span");
      autora.textContent = postagem.autora;
      const quando = document.createElement("span");
      quando.className = "publicacao__quando";
      quando.textContent = ` · ${postagem.quando}`;
      autora.append(quando);
      cabecalho.append(avatar, autora);

      const texto = document.createElement("p");
      texto.className = "publicacao__texto";
      texto.textContent = postagem.texto;

      const rodape = document.createElement("div");
      rodape.className = "publicacao__rodape";
      const curtir = document.createElement("button");
      curtir.type = "button";
      curtir.className = "publicacao__curtir";
      const ligarBotao = (marcada: boolean): void => {
        curtir.textContent = `apoiar · ${postagem.curtidas + (marcada ? 1 : 0)}`;
        curtir.setAttribute("aria-pressed", marcada ? "true" : "false");
      };
      ligarBotao(curtidas.includes(postagem.id));
      curtir.addEventListener("click", () => {
        const agora = lerJson<string[]>(CHAVE_CURTIDAS, []);
        const marcada = agora.includes(postagem.id);
        salvarJson(CHAVE_CURTIDAS, marcada ? agora.filter((id) => id !== postagem.id) : [...agora, postagem.id]);
        ligarBotao(!marcada);
      });
      rodape.append(curtir);

      card.append(cabecalho, texto, rodape);
      mural.append(card);
    }
  }

  form?.addEventListener("submit", (evento) => {
    evento.preventDefault();
    if (!form.reportValidity()) return;
    const campo = form.elements.namedItem("texto") as HTMLTextAreaElement;
    const texto = campo.value.trim();
    if (texto.length < 4) {
      if (mensagem) mensagem.textContent = "Escreva um pouco mais antes de publicar.";
      return;
    }
    const postagens = lerJson<Postagem[]>(CHAVE_POSTAGENS, []);
    const postagem: Postagem = {
      id: `local-${Date.now()}`,
      autora: usuaria?.nome ?? "Você",
      texto,
      quando: "agora",
      curtidas: 0,
    };
    salvarJson(CHAVE_POSTAGENS, [postagem, ...postagens]);
    campo.value = "";
    if (mensagem) {
      mensagem.dataset.tipo = "sucesso";
      mensagem.textContent = "Publicação criada.";
    }
    renderizar();
  });

  renderizar();
</script>
