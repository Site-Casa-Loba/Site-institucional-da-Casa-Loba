---
import Layout from "../layouts/Layout.astro";
---

<Layout>


  <!--hero-->
  <section class="hero" id="topo">

    <!-- navegação flutuante -->
    <nav class="nav-flutuante" id="navFlutuante">
      <div class="container nav-flutuante__inner">
        <a href="#topo" class="logo">
          <span class="logo__texto">casa</span>
          <img src="/assets/images/lobo_logo.svg" alt="Loba uivando" class="logo__icone" />
          <span class="logo__texto">loba</span>
        </a>
        <div class="nav-links">
          <a href="#secao-sobre">Sobre a Casa</a>
          <a href="#secao-frentes">Nossas frentes</a>
          <a href="#secao-planos">Planos</a>
          <a href="#secao-planos" class="btn btn--sm btn--vermelho">Ver planos</a>
        </div>
      </div>
    </nav>

    <!-- Arcos decorativos do hero -->
    <div class="hero__arco hero__arco--topo" aria-hidden="true"></div>
    <div class="hero__arco" aria-hidden="true"></div>

    <!-- Conteúdo do hero -->
    <div class="container hero__inner">
      <p class="tag">Rede de apoio</p>
      <h1 class="hero__titulo">
        Quem cuida<br />
        também precisa <span class="destaque">de uma rede.</span>
      </h1>
      <p class="hero__texto">
        Uma comunidade para mulheres e mães que empreendem, compartilham saberes e constroem caminhos em rede.
      </p>
      <div class="hero__acoes">
        <a href="#secao-planos" class="btn btn--vermelho">Quero fazer parte</a>
        <a href="#secao-sobre" class="btn btn--ghost">Conhecer a Casa</a>
      </div>
    </div>
  </section>

  <!-- sobre -->
  <section class="manifesto" id="secao-sobre">
    <div class="container manifesto__inner">
      <div class="uivo" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>

      <h2 class="manifesto__titulo">
        Seus projetos também precisam de espaço.
      </h2>

      <p class="manifesto__texto">
        A Casa Loba aproxima cuidado, trabalho e empreendedorismo. Em breve, Cuidadoteca, parcerias com coworkings e encontros para mulheres farão parte dessa rede.
      </p>
    </div>
  </section>

  <!-- frentes -->
  <section class="frentes" id="secao-frentes">
    <div class="container">
      <header class="section-head">
        <p class="tag tag--ameixa">Nossas frentes</p>
        <h2 class="section-titulo">Cuidado, trabalho e conexão.</h2>
      </header>

      <div class="grid-3">

        <article class="card">
          <div class="card__arco card__arco--vermelho"></div>
          <h3 class="card__titulo">Cuidadoteca</h3>
          <p class="card__texto">
            Em breve: cuidado infantil em eventos e encontros, para que mães também tenham espaço para participar, aprender e criar conexões.
          </p>
        </article>

        <article class="card">
          <div class="card__arco card__arco--azul"></div>
          <h3 class="card__titulo">Coworking</h3>
          <p class="card__texto">
            Em breve: conexões com espaços parceiros para trabalhar, trocar experiências e aproximar mulheres que empreendem.
          </p>
        </article>

        <article class="card">
          <div class="card__arco card__arco--agua"></div>
          <h3 class="card__titulo">Eventos</h3>
          <p class="card__texto">
            Em breve: encontros para compartilhar saberes, fortalecer vínculos e abrir espaço para novas ideias e parcerias.
          </p>
        </article>

      </div>
    </div>
  </section>

  <!-- planos -->
  <section class="planos" id="secao-planos">
    <div class="container">
      <header class="section-head">
        <p class="tag tag--ameixa">Assinatura</p>
        <h2 class="section-titulo">Encontre seu lugar na Casa.</h2>
        <p class="section-sub">
          Proposta de planos: nomes, valores e benefícios sujeitos à confirmação. Assinaturas em breve.
        </p>
      </header>

      <div class="grid-3">

        <article class="plano">
          <span class="plano__selo plano__selo--rosa">Para começar</span>
          <h3 class="plano__nome">Loba</h3>
          <p class="plano__preco"><span>A definir</span>/mês</p>
          <ul class="plano__lista">
            <li>Participação na comunidade</li>
            <li>Trocas entre empreendedoras</li>
            <li>Novidades da Casa Loba</li>
          </ul>
          <a href="#" class="btn btn--rosa btn--full">Em breve</a>
        </article>

        <article class="plano plano--destaque">
          <span class="plano__selo plano__selo--azul">Para se conectar</span>
          <h3 class="plano__nome">Matilha</h3>
          <p class="plano__preco"><span>A definir</span>/mês</p>
          <ul class="plano__lista">
            <li>Tudo do plano Loba</li>
            <li>Mural de conexões</li>
            <li>Seleção de cursos gravados</li>
            <li>Divulgação do seu negócio</li>
          </ul>
          <a href="#" class="btn btn--azul btn--full">Em breve</a>
        </article>

        <article class="plano">
          <span class="plano__selo plano__selo--vermelho">Para ir além</span>
          <h3 class="plano__nome">Alcateia</h3>
          <p class="plano__preco"><span>A definir</span>/mês</p>
          <ul class="plano__lista">
            <li>Tudo do plano Matilha</li>
            <li>Mais cursos gravados</li>
            <li>Encontros exclusivos</li>
            <li>Condições com parceiros</li>
          </ul>
          <a href="#" class="btn btn--vermelho btn--full">Em breve</a>
        </article>

      </div>
    </div>
  </section>

  <!-- pra quem é -->
  <section class="publico" id="secao-publico">
    <div class="container publico__inner">
      <div class="publico__texto">
        <p class="tag tag--ameixa">Para quem é</p>
        <h2 class="section-titulo">Para mulheres.<br />Para seus projetos.</h2>
        <p>
          Para mães e mulheres que empreendem e buscam com quem contar. Um convite para compartilhar experiências, criar vínculos e dar espaço às suas ideias.
        </p>
        <a href="#secao-planos" class="btn btn--ameixa">Quero fazer parte</a>
      </div>
      <div class="publico__foto" aria-hidden="true">
        <div class="foto-arco"></div>
      </div>
    </div>
  </section>

  <!-- cta final -->
  <section class="cta-final">
    <div class="container cta-final__inner">
      <h2>Seu próximo passo começa em rede.</h2>
      <p>Conheça a Casa Loba e descubra novas formas de construir caminhos com outras mulheres.</p>
      <a href="#secao-planos" class="btn btn--vermelho">Conhecer os planos</a>
    </div>
  </section>

  <!-- footer -->
  <footer class="footer">
    <div class="container footer__inner">
      <div>
        <p class="footer__logo">Casa Loba</p>
        <p class="footer__texto">Quem cuida também precisa de uma rede.</p>
      </div>
      <div class="footer__links">
        <a href="#secao-sobre">Sobre a Casa</a>
        <a href="#secao-frentes">Nossas frentes</a>
        <a href="#secao-planos">Planos</a>
        <a href="#secao-publico">Para quem é</a>
      </div>
      <p class="footer__copy">© 2026 Casa Loba · feito com cuidado</p>
    </div>
  </footer>


  <script is:inline src="/js/script.js"></script>
</Layout>
